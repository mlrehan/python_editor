# ==========================================
# ENTERPRISE PYTHON CLOUD STUDIO ENVIRONMENT
# ==========================================

# Application
APP_NAME=PythonCloudStudio
APP_ENV=development
APP_DEBUG=true
API_PORT=8000
WEB_PORT=3000

# Security & Authentication
SECRET_KEY=change-this-in-production-insecure-dev-key-32bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database (PostgreSQL / SQLite for local fallback)
# Production / Staging: postgresql+asyncpg://postgres:postgres@localhost:5432/python_cloud_studio
# Local Dev Default:
DATABASE_URL=sqlite+aiosqlite:///./studio_dev.db

# Redis (Caching & WebSocket PubSub)
REDIS_URL=redis://localhost:6379/0

# Runtime Management
DEFAULT_KERNEL_NAME=python3
MAX_CONCURRENT_KERNELS_PER_USER=5
KERNEL_IDLE_TIMEOUT_SECONDS=3600
WORKSPACES_ROOT=./storage/workspaces

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage/artifacts

# AI Assistance (Optional)
AI_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
