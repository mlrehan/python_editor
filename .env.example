# ========================================================
# ENTERPRISE PYTHON CLOUD STUDIO — PRODUCTION ENVIRONMENT
# Copy this file to .env and customize secrets before starting:
# cp .env.example .env
#
# ARCHITECTURE NOTE:
# - Docker runs: api (8765), PostgreSQL (5476), Redis (6395).
# - Host Nginx (already installed on Linux) handles reverse proxying.
# - NO Docker Nginx or Certbot container is deployed.
# - CUSTOM PORTS ONLY: API=8765, Frontend Dev=3765, Postgres=5476, Redis=6395.
# - Only HOST_PORT (8765) is bound on 127.0.0.1 (localhost only).
# ========================================================

# --------------------------------------------------------
# 1. NETWORK & CUSTOM PORTS
# --------------------------------------------------------
# Bound to 127.0.0.1 so only host Nginx can reach it (not open to public internet)
HOST_BIND_IP=127.0.0.1
HOST_PORT=8765
API_PORT=8765
WEB_PORT=3765
POSTGRES_PORT=5476
REDIS_PORT=6395

# Domain configured in your host Nginx server block
DOMAIN_NAME=studio.example.com

# --------------------------------------------------------
# 2. CORE APPLICATION SETTINGS
# --------------------------------------------------------
APP_NAME=Enterprise Python Cloud Studio
APP_ENV=production
APP_DEBUG=false

# --------------------------------------------------------
# 3. SECURITY & AUTHENTICATION SECRETS (CRITICAL)
# --------------------------------------------------------
# Generate a cryptographically secure 64-character secret key:
# Run: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_64_CHAR_KEY_IN_PRODUCTION!!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --------------------------------------------------------
# 4. INITIAL SUPER ADMIN BOOTSTRAP CREDENTIALS
# Used only on first database initialization to create the primary Super Admin
# --------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_STRONG_COMPLEX_PASSWORD_2026!

# --------------------------------------------------------
# 5. POSTGRESQL DATABASE CONFIGURATION (Custom Port 5476 on Internal Network)
# --------------------------------------------------------
POSTGRES_USER=pcs_user
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DB_PASSWORD_2026
POSTGRES_DB=python_cloud_studio

# --------------------------------------------------------
# 6. REDIS BROKER & CACHE CONFIGURATION (Custom Port 6395 on Internal Network)
# --------------------------------------------------------
REDIS_URL=redis://redis:6395/0

# --------------------------------------------------------
# 7. RUNTIME EXECUTION & RESOURCE LIMITS
# --------------------------------------------------------
DEFAULT_KERNEL_NAME=python3
MAX_CONCURRENT_KERNELS_PER_USER=5
KERNEL_IDLE_TIMEOUT_SECONDS=3600

# Container resource limits (leave empty for compose defaults)
API_CPU_LIMIT=1.5
API_MEM_LIMIT=2G
DB_CPU_LIMIT=1.0
DB_MEM_LIMIT=1G
REDIS_CPU_LIMIT=0.5
REDIS_MEM_LIMIT=512M

# --------------------------------------------------------
# 8. WORKSPACE & PERSISTENCE STORAGE
# --------------------------------------------------------
WORKSPACES_ROOT=/app/storage/workspaces
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage/artifacts
