FROM nginx:1.27-alpine

# Install gettext for envsubst
RUN apk add --no-cache gettext curl

COPY infrastructure/docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY infrastructure/docker/nginx/templates/ /etc/nginx/templates/
COPY infrastructure/docker/nginx/docker-entrypoint.sh /docker-entrypoint.sh

RUN chmod +x /docker-entrypoint.sh

EXPOSE 80 443

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/api/v1/health || curl -f http://localhost/ || exit 1

ENTRYPOINT ["/docker-entrypoint.sh"]

