# ==========================================
# ENTERPRISE PYTHON CLOUD STUDIO - RUNTIME SANDBOX
# ==========================================
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/home/sandboxuser

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged user (UID 1000)
RUN useradd -m -u 1000 -s /bin/bash sandboxuser

# Install core scientific packages
RUN pip install --no-cache-dir \
    ipykernel \
    debugpy \
    numpy \
    pandas \
    matplotlib \
    scipy \
    requests

USER 1000
WORKDIR /home/sandboxuser/workspace

EXPOSE 8888

CMD ["python", "-m", "ipykernel_launcher", "-f", "/tmp/kernel-connection.json"]

