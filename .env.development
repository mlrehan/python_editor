# ========================================================
# Enterprise Python Cloud Studio — Local Docker Testing
# Windows 11 Development Configuration (.env.development)
# STRICT ZERO DEFAULT PORTS: 5432, 6379, 8000, 3000, 80, 443 are NEVER exposed.
# NO NGINX IN LOCAL DEV: Only port 8765 is mapped on the host.
# ========================================================

# --------------------------------------------------------
# Host Port Binding (Direct access to FastAPI, No Nginx)
# --------------------------------------------------------
HOST_PORT=8765
HOST_BIND_IP=127.0.0.1
DOMAIN_NAME=localhost

# --------------------------------------------------------
# Application Settings
# --------------------------------------------------------
APP_NAME=Enterprise Python Cloud Studio (Local Docker)
APP_ENV=development
APP_DEBUG=true

# --------------------------------------------------------
# Security & JWT Secrets (Local Testing)
# --------------------------------------------------------
SECRET_KEY=pcs-local-docker-dev-secret-key-32chars!!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --------------------------------------------------------
# Super Admin Bootstrap Credentials
# --------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=AdminSecurePassword2026!

# --------------------------------------------------------
# PostgreSQL Database Settings (Internal to Docker network only)
# --------------------------------------------------------
POSTGRES_USER=pcs_user
POSTGRES_PASSWORD=pcs_dev_password_2026
POSTGRES_DB=python_cloud_studio

# --------------------------------------------------------
# Redis Cache & Broker Settings (Internal to Docker network only)
# --------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --------------------------------------------------------
# Runtime & Workspace Limits
# --------------------------------------------------------
DEFAULT_KERNEL_NAME=python3
MAX_CONCURRENT_KERNELS_PER_USER=5
KERNEL_IDLE_TIMEOUT_SECONDS=3600

WORKSPACES_ROOT=/app/storage/workspaces
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage/artifacts
