# ========================================================
# ENTERPRISE PYTHON CLOUD STUDIO — PRODUCTION TEMPLATE
# Copy to .env on your Linux production server:
# cp .env.production.example .env
#
# ARCHITECTURE NOTE:
# - Production server (root@vmi3043660) already has host Nginx installed.
# - Existing sites like /etc/nginx/sites-available/lms are completely untouched.
# - Python Cloud Studio backend runs in Docker and binds ONLY to 127.0.0.1:8765.
# - NO Docker Nginx container is run.
# - CUSTOM PORTS ONLY: API=8765, Frontend Dev=3765, Postgres=5476, Redis=6395.
# ========================================================

# --------------------------------------------------------
# 1. Network & Custom Port Binding
# --------------------------------------------------------
HOST_BIND_IP=127.0.0.1
HOST_PORT=8765
API_PORT=8765
WEB_PORT=3765
POSTGRES_PORT=5476
REDIS_PORT=6395
DOMAIN_NAME=studio.example.com

# --------------------------------------------------------
# 2. Application Identity
# --------------------------------------------------------
APP_NAME=Enterprise Python Cloud Studio
APP_ENV=production
APP_DEBUG=false

# --------------------------------------------------------
# 3. Security & Cryptographic Secrets (CRITICAL)
# Generate a 64-char key using: openssl rand -hex 32
# --------------------------------------------------------
SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_64_CHAR_KEY_IN_PRODUCTION!!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --------------------------------------------------------
# 4. Super Admin Initial Bootstrap
# --------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_STRONG_COMPLEX_PASSWORD_2026!

# --------------------------------------------------------
# 5. Production PostgreSQL Database (Custom Port 5476 on Internal Docker Network)
# --------------------------------------------------------
POSTGRES_USER=pcs_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD_2026
POSTGRES_DB=python_cloud_studio

# --------------------------------------------------------
# 6. Redis Broker (Custom Port 6395 on Internal Docker Network)
# --------------------------------------------------------
REDIS_URL=redis://redis:6395/0

# --------------------------------------------------------
# 7. Runtime Sandbox & Resource Quotas
# --------------------------------------------------------
DEFAULT_KERNEL_NAME=python3
# Capacity: until per-user runtime containers exist (Phase 1), every kernel runs in the API container.
# An active kernel uses ~150-400 MB. Size: API_MEM_LIMIT ~= MAX_TOTAL_KERNELS x 250 MB + 1 GB.
# Abandoned kernels (no browser attached) are reaped after KERNEL_DETACHED_TIMEOUT_SECONDS and
# evicted first when the server is full; kernels above KERNEL_MAX_MEMORY_MB are killed.
MAX_CONCURRENT_KERNELS_PER_USER=3
MAX_TOTAL_KERNELS=40
MAX_GUEST_KERNELS=10
KERNEL_IDLE_TIMEOUT_SECONDS=3600
KERNEL_DETACHED_TIMEOUT_SECONDS=600
KERNEL_MAX_MEMORY_MB=1024

API_CPU_LIMIT=4
API_MEM_LIMIT=12G
API_PIDS_LIMIT=4096
DB_CPU_LIMIT=1.0
DB_MEM_LIMIT=1G
REDIS_CPU_LIMIT=0.5
REDIS_MEM_LIMIT=512M

# --------------------------------------------------------
# 8. Storage Volumes
# --------------------------------------------------------
WORKSPACES_ROOT=/app/storage/workspaces
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage/artifacts
